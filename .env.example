# Copy to .env in the project root and fill in your keys.
# Do NOT commit .env (it is gitignored).

# --- LLM (required for profile parsing, tailoring, cover letter, interview prep) ---
# Option A: Groq (free) — https://console.groq.com — key MUST start with gsk_
GROQ_API_KEY=gsk_your_groq_key_here
LLM_MODEL=llama-3.3-70b-versatile

# Option B: Google Gemini (free) — https://aistudio.google.com/apikey
# GEMINI_API_KEY=your_gemini_key_here
# (alias: GOOGLE_API_KEY=...)
# GEMINI_MODEL=gemini-2.0-flash
# LLM_PROVIDER=gemini

# --- Job search (optional; demo jobs used if missing) ---
# SERPER_API_KEY=your_serper_key

# --- Vector DB (optional; in-memory fallback if missing) ---
# PINECONE_API_KEY=
# PINECONE_INDEX_NAME=job-embeddings
